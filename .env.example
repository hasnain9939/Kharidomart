# Environment variables example for Kharido Mart
# Prisma SQLite (Local Development - Zero Configuration)
DATABASE_URL="file:./dev.db"

# For Production (PostgreSQL / Supabase / Neon / Railway):
# DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Store Settings
NEXT_PUBLIC_STORE_NAME="Kharido Mart"
NEXT_PUBLIC_STORE_CURRENCY="INR"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"

# Administrator Authentication Credentials
ADMIN_EMAIL="admin@kharidomart.com"
ADMIN_PASSWORD="your_secure_password_here"

# Optional Secondary Admin Account
ADMIN_EMAIL_2=""
ADMIN_PASSWORD_2=""

# Google OAuth 2.0 (Google Identity Services for Customer Login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Razorpay Payment Gateway (UPI, Cards, NetBanking, Wallets)
# Obtain from: https://dashboard.razorpay.com/app/keys (Settings > API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID_HERE"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET_HERE"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET_HERE"

# Shopify Warehouse & Dropshipping Sync
# 1. SHOPIFY_STORE_DOMAIN: e.g. "your-store.myshopify.com"
# 2. SHOPIFY_ADMIN_ACCESS_TOKEN: starts with "shpat_..." from Shopify Admin > Settings > Apps > Develop apps
SHOPIFY_STORE_DOMAIN="your-store-name.myshopify.com"
SHOPIFY_CLIENT_ID="your_shopify_app_client_id"
SHOPIFY_CLIENT_SECRET="your_shopify_app_client_secret"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_VERSION="2024-01"
SHOPIFY_WEBHOOK_SECRET="optional_webhook_signing_secret"


