# Environment variables example for Kharido Mart
# Prisma SQLite (Local Development - Zero Configuration)
DATABASE_URL="file:./dev.db"

# For Production (PostgreSQL / Supabase / Neon / Railway):
# DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Store Settings
NEXT_PUBLIC_STORE_NAME="Kharido Mart"
NEXT_PUBLIC_STORE_CURRENCY="INR"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"

# Administrator Authentication Credentials
ADMIN_EMAIL="admin@kharidomart.com"
ADMIN_PASSWORD="your_secure_password_here"

# Optional Secondary Admin Account
ADMIN_EMAIL_2=""
ADMIN_PASSWORD_2=""

# Google OAuth 2.0 (Google Identity Services for Customer Login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
